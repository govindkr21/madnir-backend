# ─── Server ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
DEBUG=OFF
LOGS_TYPE=RSP-GTE-500            # ALL | RSP-GTE-<ms>

# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGIN=https://app.example.com,https://admin.example.com

# Public URL of the doctor frontend (used for invite links + redirects).
FRONTEND_URL=https://app.example.com

# ─── Database ────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster/doctor

# ─── Auth ────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

# ─── Platform support contact ────────────────────────────────────
# Shown in the "Renew with your admin" popup when an organization expires
# AND no per-organization supportContact has been configured by the platform admin.
PLATFORM_SUPPORT_NAME=Madnir Support
PLATFORM_SUPPORT_EMAIL=support@rxmind.io
PLATFORM_SUPPORT_PHONE=+91 90000 00000

# ─── Email / Resend ─────────────────────────────────────────────
# Required in production. Obtain the API key from the Resend dashboard.
RESEND_API_KEY=
# Must be a sender address or "Name <sender@verified-domain>" verified in Resend.
MAIL_FROM=Madnir <noreply@example.com>
# Used by recipients when they reply to transactional mail.
MAIL_REPLY_TO=support@example.com
# Mailbox shown in email support links and organization support fallbacks.
SUPPORT_EMAIL=support@example.com
# Development-only recipient redirect. Keep empty in production.
DEV_MAIL_OVERRIDE=

# ─── Email branding ────────────────────────────────────────────
BRAND_NAME=Madnir
BRAND_TAGLINE=
BRAND_COLOR_PRIMARY=#0F766E
BRAND_LOGO_URL=

# Cloudinary file and image storage: required for uploads and stored signatures
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_BYTES=5242880

# ─── Rate limits ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
