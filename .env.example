# ─── Server ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
DEBUG=OFF
LOGS_TYPE=RSP-GTE-500            # ALL | RSP-GTE-<ms>

# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGIN=https://app.example.com,https://admin.example.com

# Public URL of the doctor frontend (used for invite links + redirects).
FRONTEND_URL=https://app.example.com

# ─── Database ────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster/doctor

# ─── Auth ────────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

# ─── Platform support contact ────────────────────────────────────
# Shown in the "Renew with your admin" popup when an organization expires
# AND no per-organization supportContact has been configured by the platform admin.
PLATFORM_SUPPORT_NAME=RxMind Support
PLATFORM_SUPPORT_EMAIL=support@rxmind.io
PLATFORM_SUPPORT_PHONE=+91 90000 00000

# ─── Rate limits ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
